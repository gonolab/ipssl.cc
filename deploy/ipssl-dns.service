[Unit]
Description=ipssl wildcard DNS server
Documentation=https://ipssl.cc
After=network-online.target
Wants=network-online.target
# With acme.key the challenge API signs each write with the time, and this
# server refuses times more than 30 s off its own clock: start once the
# clock is set. This waits for a sync only where a service such as
# systemd-time-wait-sync or chrony-wait holds time-sync.target back.
After=time-sync.target
Wants=time-sync.target

[Service]
ExecStart=/usr/local/bin/ipssl-dns -c /etc/ipssl/config.toml
# `systemctl reload ipssl-dns` re-reads the config without a restart and
# returns once the server has. The helper checks the file first, as the
# service user, so a config the server would refuse (or cannot read)
# fails the reload. It then sends SIGHUP and waits for the server's own
# result in the runtime directory: success once the new zone is served,
# failure with the server's error if it kept the running config.
# Keep its binary and config paths the same as ExecStart.
ExecReload=/usr/local/bin/ipssl-dns -c /etc/ipssl/config.toml --reload $MAINPID
# /run/ipssl-dns, where the server reports reloads. Writable by the
# service user despite ProtectSystem=strict; removed when the service stops.
RuntimeDirectory=ipssl-dns
Restart=always
RestartSec=2
LimitNOFILE=65536

# Run as a throwaway non-root user, allowed only to bind port 53
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening: read-only file system, no access to home directories,
# devices or kernel settings
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
