[Unit]
Description=ipssl wildcard DNS server
Documentation=https://ipssl.cc
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ipssl-dns -c /etc/ipssl/config.toml
Restart=always
RestartSec=2
LimitNOFILE=65536

# Run as a throwaway non-root user, allowed only to bind port 53
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening: read-only file system, no access to home directories,
# devices or kernel settings
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
